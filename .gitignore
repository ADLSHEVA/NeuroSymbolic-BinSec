# ============================================================
#  NeuroSymbolic-BinSec — .gitignore
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# ---- OS / editor junk ----
.DS_Store
__MACOSX/
Thumbs.db
*.swp

# ---- Local tooling & SECRETS (never commit) ----
.claude/
.codegraph/
.env
*.local.json
# API keys are read from the MIMO_API_KEY / MIMO_API_BASE env vars — never hardcode.

# ---- Run outputs, logs & generated reports (re-created every run) ----
output/*
# …but KEEP the TYGR reproduction scripts/docs/demos under output/tygr/
# (env build, demos) — their binaries/models/datasets stay excluded by rules below.
!output/tygr/
output/tygr/*
!output/tygr/*.sh
!output/tygr/*.py
!output/tygr/*.md
!output/tygr/*.c
!output/tygr/req_rest.txt

# ---- Trained model weights & datasets (large binaries) ----
# Regenerate with scripts/generate_training_data.py + scripts/train_*.py
data/
*.pt
*.model
*.pkl
*.log

# ---- Benchmarks: keep harness/cases/support/results, drop compiled binaries & clones ----
benchmarks/juliet/build/
benchmarks/juliet/repo/

# ---- Third-party: TYGR (https://github.com/sefcom/TYGR) ----
# TYGR has NO license file => "All Rights Reserved" => NOT redistributable here.
# Obtain it yourself from the official repo and place it under tygr/ locally.
# NOTE: root-anchored so it does NOT also match output/tygr/ (our repro scripts).
/tygr/
/tygr_original/

# ---- Compiled test binaries (regenerated by the compilation stage) ----
tests/test_binaries/
*.o
*.elf
*.stripped
